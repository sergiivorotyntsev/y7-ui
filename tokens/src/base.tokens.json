{
  "$description": "Y7 UI base tokens shared by every theme. DTCG 2025.10. Built by Style Dictionary (tokens/build.mjs) into CSS custom properties prefixed --y7- and a JS map.",
  "space": {
    "$description": "Spacing scale. Components read only these.",
    "xxs": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "3xl": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "size": {
    "control": {
      "$description": "Control heights (C2). One height per toolbar row: md. Touch targets: touch (C5, 44px at pointer: coarse).",
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 28,
          "unit": "px"
        },
        "$description": "Chips and compact controls"
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 36,
          "unit": "px"
        },
        "$description": "Toolbar and filter-bar controls"
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Primary actions and forms"
      },
      "touch": {
        "$type": "dimension",
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Minimum target on touch widths"
      }
    },
    "row": {
      "$type": "dimension",
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "Table row header height (fixed; expanding never moves it)."
    },
    "icon": {
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        }
      }
    },
    "panel": {
      "width": {
        "$type": "dimension",
        "$value": {
          "value": 480,
          "unit": "px"
        },
        "$description": "Side panel width on wide screens"
      },
      "sheet-max": {
        "$type": "dimension",
        "$value": {
          "value": 560,
          "unit": "px"
        },
        "$description": "Filter sheet max width"
      }
    },
    "control-min-width": {
      "$type": "dimension",
      "$value": {
        "value": 160,
        "unit": "px"
      },
      "$description": "Minimum width of a filter-bar control so a label change across locales never changes the row."
    }
  },
  "font": {
    "family": {
      "ui": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "Noto Sans",
          "sans-serif"
        ],
        "$description": "ONE UI stack for en, pl, uk and ru (T2). System fonts carry Cyrillic and Polish diacritics; a Latin-only webfont is never used for controls."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Tabular data and identifiers. Not for controls."
      }
    },
    "size": {
      "$description": "Type scale, six steps covering 11 to 20 px (T1). Components read only these.",
      "2xs": {
        "$type": "dimension",
        "$value": {
          "value": 11,
          "unit": "px"
        },
        "$description": "Mono micro labels"
      },
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$description": "Captions, chip text"
      },
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$description": "Field labels, table meta"
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "Controls and body in dense UI"
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Reading body"
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "Panel and dialog titles"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    },
    "line-height": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "normal": {
        "$type": "number",
        "$value": 1.45
      },
      "loose": {
        "$type": "number",
        "$value": 1.65
      }
    },
    "tracking": {
      "caps": {
        "$type": "dimension",
        "$value": {
          "value": 0.06,
          "unit": "em"
        },
        "$description": "Uppercase UI labels"
      }
    }
  },
  "focus": {
    "$description": "Keyboard focus ring geometry (X2). The colour lives in color.focus per theme.",
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "offset": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "border": {
    "width": {
      "hairline": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "strong": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "Error state border on a field (A2/X2: error is a border on the field, focus is a ring outside it)."
      }
    }
  },
  "z": {
    "$description": "Stacking scale (v0.1.3): content < sticky-header < drawer < overlay < toast. The overlay and drawer clear a host page's fixed chrome (the website's bars sit at 990 to 1000); toasts stay above modals. React Aria popovers set their own z-index above all of these.",
    "content": {
      "$type": "number",
      "$value": 1
    },
    "dropdown": {
      "$type": "number",
      "$value": 20
    },
    "bottom-nav": {
      "$type": "number",
      "$value": 30
    },
    "sticky-header": {
      "$type": "number",
      "$value": 100,
      "$description": "The host's sticky site header (the website's Header.module.css uses 100)."
    },
    "drawer": {
      "$type": "number",
      "$value": 1050
    },
    "overlay": {
      "$type": "number",
      "$value": 1100
    },
    "toast": {
      "$type": "number",
      "$value": 9999
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.5
    },
    "busy-dim": {
      "$type": "number",
      "$value": 0.6,
      "$description": "Previous content dimmed while reloading (S2)."
    }
  },
  "motion": {
    "lift-hover": {
      "$type": "dimension",
      "$value": {
        "value": -3,
        "unit": "px"
      },
      "$description": "Card hover lift cap (DESIGN.md: never past -3px)."
    }
  }
}
