{
  "name": "@sergiivorotyntsev/y7-ui",
  "version": "0.1.0",
  "description": "Y7 shared UI library: DTCG tokens (site + admin themes), React Aria primitives styled with CSS modules, and the ESLint/Stylelint gates both apps run.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "sideEffects": ["*.css"],
  "files": ["src", "tokens/dist", "tokens/src", "lint", "docs", "README.md"],
  "exports": {
    ".": "./src/index.js",
    "./tokens/site.css": "./tokens/dist/site.css",
    "./tokens/admin.css": "./tokens/dist/admin.css",
    "./tokens/site.scoped.css": "./tokens/dist/site.scoped.css",
    "./tokens/admin.scoped.css": "./tokens/dist/admin.scoped.css",
    "./tokens/site": "./tokens/dist/site.js",
    "./tokens/admin": "./tokens/dist/admin.js",
    "./tokens": "./tokens/dist/index.js",
    "./eslint": "./lint/eslint.js",
    "./stylelint": "./lint/stylelint.cjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node tokens/build.mjs",
    "test:tokens": "node --test tokens/test/",
    "test:logic": "node --test src/**/*.logic.test.mjs",
    "test:unit": "vitest run",
    "test": "npm run test:tokens && npm run test:logic && npm run test:unit",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "npm run tokens"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "react-aria-components": "1.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.6",
    "style-dictionary": "^5.8.0",
    "stylelint": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
